{
  "name": "mac-inference-lab-video",
  "version": "1.0.0",
  "private": true,
  "description": "Silent, evidence-linked animation of Mac Inference Lab pilot-002",
  "scripts": {
    "data": "python3 prepare_data.py",
    "studio": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx MacInferenceDashboard ../media/mac-inference-dashboard.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --concurrency=4",
    "poster": "remotion still src/index.tsx MacInferenceDashboard ../media/mac-inference-dashboard.png --frame=450",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
